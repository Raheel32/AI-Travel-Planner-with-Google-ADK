# Copy this file to ".env" (same folder) and fill in your values.
# NEVER commit .env to GitHub.

# --- Gemini (get a free key at https://aistudio.google.com/apikey) ---
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=paste_your_gemini_key_here

# --- Which model the agents use (change if your key doesn't support it) ---
TRAVEL_MODEL=gemini-3.8-flash

# --- Travel data: "mock" (no key needed) or "serpapi" (real prices) ---
TRAVEL_DATA_PROVIDER=mock
SERPAPI_API_KEY=

# --- Optional: how long cached API responses stay valid (hours) ---
TRAVEL_CACHE_TTL_HOURS=24

# --- Free-tier friendliness (see README) ---
# false = research agents run one after another (gentler on per-minute limits)
TRAVEL_PARALLEL_RESEARCH=false
# false = skip Google Search grounding to save quota (destination info is then unverified)
TRAVEL_USE_SEARCH=true